# Server
PORT=4000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=los_db
DB_USER=los_user
DB_PASSWORD=los_password
DATABASE_URL=postgresql://los_user:los_password@localhost:5432/los_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h

# Frontend
FRONTEND_URL=http://localhost:3000

# Mock API Keys (not real - used for simulation)
OPENAI_API_KEY=mock-key-not-real
CREDIT_BUREAU_API_KEY=mock-bureau-key
OFAC_API_KEY=mock-ofac-key

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
