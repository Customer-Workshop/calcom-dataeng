# Server
PORT=4000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=los_db
DB_USER=los_user
DB_PASSWORD=los_password
DATABASE_URL=postgresql://los_user:los_password@localhost:5432/los_db

# JWT — 1-hour access tokens, 7-day refresh tokens
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d

# Encryption — AES-256-GCM field-level encryption for PII (SSN, DOB, income, account numbers)
# In production, use a KMS-managed key (AWS KMS, HashiCorp Vault, etc.)
ENCRYPTION_KEY=your-encryption-key-change-in-production
HASH_PEPPER=your-hash-pepper-change-in-production

# Frontend
FRONTEND_URL=http://localhost:3000

# Mock API Keys (not real - used for simulation)
OPENAI_API_KEY=mock-key-not-real
CREDIT_BUREAU_API_KEY=mock-bureau-key
OFAC_API_KEY=mock-ofac-key

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ── Scalability & Performance ────────────────────────────────
# Connection pool — adjust POOL_MAX based on (PostgreSQL max_connections ÷ cluster workers)
POOL_MIN=5
POOL_MAX=50
POOL_ACQUIRE_TIMEOUT=5000
POOL_IDLE_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=30000

# Request handling — backpressure and timeout settings
MAX_CONCURRENT_REQUESTS=500
REQUEST_TIMEOUT_MS=30000

# Cluster mode — number of workers (defaults to CPU core count)
# CLUSTER_WORKERS=4

# Rate limiting — per 15-minute window per IP
RATE_LIMIT_API=1000
RATE_LIMIT_AUTH=20
RATE_LIMIT_SENSITIVE=10
